# ---- Frontend (exposed to the browser — never put secrets in VITE_ variables) ----

# URL the enquiry form POSTs to (multipart/form-data).
# Using the bundled Vercel function: /api/enquiry
# Leave empty and the form will tell visitors to email/call instead of pretending to send.
VITE_ENQUIRY_ENDPOINT=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Empty = no analytics loaded.
VITE_GA_ID=

# ---- Server only (set in your hosting dashboard, used by api/enquiry.ts) ----

# Resend API key (https://resend.com) used to email enquiries with attachments.
RESEND_API_KEY=
# Inbox that receives enquiries.
ENQUIRY_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Arte Website <website@arteind.com>"
ENQUIRY_FROM_EMAIL=
